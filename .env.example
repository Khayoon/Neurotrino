# Optional: omit for persistent, embedded PostgreSQL in .data/postgres.
# Use a direct or session-pool PostgreSQL connection for Supabase.
DATABASE_URL=
# Required when DATABASE_URL is set or deploying outside localhost. At least 32 characters.
EDITOR_TOKEN=
# Set to your public origin in deployment, e.g. https://neurotrino.example
APP_ORIGIN=http://localhost:3000
# Optional local database directory (one running app process per directory).
NEUROTRINO_DATA_DIR=.data
